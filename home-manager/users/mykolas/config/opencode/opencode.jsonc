{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "name": "LM Studio",
      "api": "openai",
      "options": {
        "baseURL": "http://localhost:1234/v1",
        "apiKey": "{env:OPENCODE_LM_STUDIO_API_KEY}"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B",
          "tool_call": true,
          "limit": { "context": 262144, "output": 65536 }
        },
        "qwen3.6-35b-a3b-mtp-iq4_nl": {
          "name": "Qwen3.6 35B A3B MTP (IQ4_NL)",
          "tool_call": true,
          "limit": { "context": 262144, "output": 65536 }
        },
        "huihui-qwen3.6-27b-abliterated-mtp@q3_k": {
          "name": "huihui-qwen3.6-27b-abliterated-mtp@q3_k",
          "tool_call": true,
          "limit": { "context": 262144, "output": 65536 }
        },
        "qwen/text-embedding-qwen3-embedding-0.6b:Q8_0": {
          "name": "Qwen3 Embedding 0.6B (Q8_0)",
          "tool_call": false,
          "limit": { "context": 32768, "output": 1 }
        },
        "enacimie/text-embedding-qwen3-embedding-0.6b:Q4_K_M": {
          "name": "Qwen3 Embedding 0.6B (Q4_K_M)",
          "tool_call": false,
          "limit": { "context": 32768, "output": 1 }
        },
        "text-embedding-qwen3-embedding-4b": {
          "name": "Qwen3 Embedding 4B",
          "tool_call": false,
          "limit": { "context": 32768, "output": 1 }
        }
      }
    },
    "openrouter": {
      "name": "OpenRouter",
      "api": "openai",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "moonshotai/kimi-k2.7-code": {
          "name": "Moonshot AI Kimi K2.7 Code",
          "tool_call": true,
          "limit": { "context": 262144, "output": 262144 }
        },
        "deepseek/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "tool_call": true,
          "limit": { "context": 1048576, "output": 384000 }
        },
        "qwen/qwen3.7-plus": {
          "name": "Qwen 3.7 Plus",
          "tool_call": true,
          "limit": { "context": 1000000, "output": 64000 }
        },
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "tool_call": true,
          "limit": { "context": 1048576, "output": 384000 }
        }
      }
    },
    "cline": {
      "name": "Cline (ClinePass)",
      "api": "openai",
      "options": {
        "baseURL": "https://api.cline.bot/api/v1",
        "apiKey": "{env:CLINE_API_KEY}"
      },
      "models": {
        "cline-pass/qwen3.7-max": {
          "name": "Qwen 3.7 Max",
          "tool_call": true,
          "limit": { "context": 1000000, "output": 64000 },
          "reasoning": true,
          "reasoning_options": [{ "type": "effort", "values": ["none", "low", "medium", "high", "xhigh"] }],
          "options": { "reasoningEffort": "high" }
        },
        "cline-pass/qwen3.7-plus": {
          "name": "Qwen 3.7 Plus",
          "tool_call": true,
          "limit": { "context": 256000, "output": 64000 },
          "reasoning": true,
          "reasoning_options": [{ "type": "effort", "values": ["none", "low", "medium", "high", "xhigh"] }],
          "options": { "reasoningEffort": "high" }
        },
        "cline-pass/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "tool_call": true,
          "limit": { "context": 1048576, "output": 384000 },
          // "reasoning": true,
          // "reasoning_options": [{ "type": "effort", "values": ["none", "low", "medium", "high", "xhigh"] }],
          // "options": { "reasoningEffort": "high" }
        },
        "cline-pass/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "tool_call": true,
          "limit": { "context": 1048576, "output": 384000 },
          "reasoning": true,
          "reasoning_options": [{ "type": "effort", "values": ["none", "low", "medium", "high", "xhigh"] }],
          "options": { "reasoningEffort": "high" }
        },
        "cline-pass/kimi-k2.7-code": {
          "name": "Kimi K2.7 Code",
          "tool_call": true,
          "limit": { "context": 262144, "output": 262144 },
          "reasoning": true,
          "reasoning_options": [{ "type": "effort", "values": ["none", "low", "medium", "high", "xhigh"] }],
          "options": { "reasoningEffort": "high" }
        },
        "cline-pass/glm-5.2": {
          "name": "GLM-5.2",
          "tool_call": true,
          "limit": { "context": 262144, "output": 65536 },
          "reasoning": true,
          "reasoning_options": [{ "type": "effort", "values": ["none", "low", "medium", "high", "xhigh"] }],
          "options": { "reasoningEffort": "high" }
        },
        "cline-pass/minimax-m3": {
          "name": "MiniMax M3",
          "tool_call": true,
          "limit": { "context": 262144, "output": 65536 },
          "reasoning": true,
          "reasoning_options": [{ "type": "effort", "values": ["none", "low", "medium", "high", "xhigh"] }],
          "options": { "reasoningEffort": "high" }
        }
      }
    }
  },
  "mcp": {
    "kagi": {
      "type": "local",
      "command": ["uvx", "kagimcp"],
      "enabled": true,
      "environment": {
        "KAGI_API_KEY": "{env:KAGI_API_KEY}",
        "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt",
        "NIX_SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"
      }
    },
    "agent-search": {
      "type": "local",
      "command": ["/home/mykolas/.venvs/agent-search-mcp/bin/agent-search-mcp"],
      "enabled": true
    }
  }
}
